	partition Sel_Mes = calculated
		mode: import
		source = VAR __a = EOMONTH ( MAX ( Referencia[Hoje] ), -1 ) VAR __b = EOMONTH ( MAX ( Referencia[Hoje] ), 0 ) RETURN SELECTCOLUMNS ( { ( UPPER ( LEFT ( FORMAT ( __a, "mmm/yy" ), 1 ) ) & MID ( FORMAT ( __a, "mmm/yy" ), 2, 10 ), 1, "Mês anterior" ), ( UPPER ( LEFT ( FORMAT ( __b, "mmm/yy" ), 1 ) ) & MID ( FORMAT ( __b, "mmm/yy" ), 2, 10 ), 2, "Mês atual" ) }, "Opcao", [Value1], "Ordem", [Value2], "Mes_Relativo", [Value3] )

	annotation PBI_Id = 18b7d8cdb9dedef8d2f2583de7ed7b4d

