		lineageTag: 6ed4bca2-d0f9-4d3e-b80a-a013226dd077
		summarizeBy: none
		sourceColumn: ID_Estado

		annotation SummarizationSetBy = Automatic

	column ID_Campanha
		dataType: int64
		formatString: 0
		lineageTag: 88e44707-ffb7-45d2-9fe6-598788008094
		summarizeBy: none
		sourceColumn: ID_Campanha

		annotation SummarizationSetBy = Automatic

	column ID_Tema
		dataType: int64
		formatString: 0
		lineageTag: 133b6a1f-d63b-4ddb-94aa-15a54a6ab915
		summarizeBy: none
		sourceColumn: ID_Tema

		annotation SummarizationSetBy = Automatic

	column Data_Implantadas =
			
			MAXX(
			    FILTER(
			        ALL(Dim_SLA_Ideias),
			        Dim_SLA_Ideias[Chave_Primaria] = Fato_Ideias[Chave_Primaria]
			            && TRIM(Dim_SLA_Ideias[Andamento_Etapa]) = "Implantada"
			            && (
			                ISBLANK(Dim_SLA_Ideias[Data_de_Saida])
			                || Dim_SLA_Ideias[Data_de_Saida] < DATE(1900,1,1)
			            )
			    ),
			    Dim_SLA_Ideias[Data_de_Entrada]
			)
		formatString: General Date
		lineageTag: 65d510ac-c835-42e0-bead-df2060422827
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'resultado.CriadoEm'
		dataType: dateTime
		formatString: General Date
		lineageTag: 8412ed18-6a23-49a4-a049-da288d52b4e5
		summarizeBy: none
		sourceColumn: resultado.CriadoEm

		annotation SummarizationSetBy = Automatic

	column Dias_Etapa_Atual = VAR __k = Fato_Ideias[Chave_Primaria] RETURN MAXX ( FILTER ( ALL ( Dim_SLA_Ideias ), Dim_SLA_Ideias[Chave_Primaria] = __k && Dim_SLA_Ideias[É_Ultimo_Status] = 1 ), Dim_SLA_Ideias[Dias_na_Etapa] )
		displayFolder: _Design
		lineageTag: 6d764e45-13bc-4e57-b8f8-8dbe7c240967

	column Veio_De = VAR _v = VAR __k = Fato_Ideias[Chave_Primaria] RETURN MAXX ( FILTER ( ALL ( Dim_SLA_Ideias ), Dim_SLA_Ideias[Chave_Primaria] = __k && Dim_SLA_Ideias[É_Ultimo_Status] = 1 ), Dim_SLA_Ideias[Etapa_Anterior] ) RETURN IF ( ISBLANK ( _v ), "—", _v )
		displayFolder: _Design
		lineageTag: e759b8c9-604f-4501-b225-038e3b195477

	column Data_Etapa_Atual = VAR __k = Fato_Ideias[Chave_Primaria] RETURN MAXX ( FILTER ( ALL ( Dim_SLA_Ideias ), Dim_SLA_Ideias[Chave_Primaria] = __k && Dim_SLA_Ideias[É_Ultimo_Status] = 1 ), Dim_SLA_Ideias[Data_de_Entrada] )
		formatString: dd/mm/yy
		displayFolder: _Design
		lineageTag: 8bdb44c2-901c-421f-8735-f581400427bd

	column Lead_Time_Dias = IF ( RELATED ( Dim_Estado[Estados] ) = "Implantada" && NOT ISBLANK ( Fato_Ideias[Data_Implantadas] ), DATEDIFF ( Fato_Ideias[resultado.CriadoEm], Fato_Ideias[Data_Implantadas], DAY ) )
		displayFolder: _Design
		lineageTag: 7cc61085-ea87-4d6f-a737-edd4a9388543

	column Etapa_Atual = SWITCH ( RELATED ( Dim_Estado[Estados] ), "ETAPA 1: AVALIAÇÃO", "Avaliação", "ETAPA 2: PROPOSTA DE SOLUÇÃO", "Proposta de Solução", "BANCO DE IDEIAS", "Banco de Ideias", "Validação da Implantação", "Validação", RELATED ( Dim_Estado[Estados] ) )
		displayFolder: _Design
		lineageTag: c84166ec-4070-4d66-809c-6ad8807a4f88
		sortByColumn: Etapa_Atual_Ordem

	column Etapa_Atual_Ordem = SWITCH ( RELATED ( Dim_Estado[Estados] ), "ETAPA 1: AVALIAÇÃO", 1, "ETAPA 2: PROPOSTA DE SOLUÇÃO", 2, "Aprovada", 3, "Em Implantação", 4, "Validação da Implantação", 5, "Implantada", 6, "BANCO DE IDEIAS", 7, "Reprovada", 8, 9 )
		isHidden
		displayFolder: _Design
		lineageTag: 03f144d7-8fc1-4d56-aed6-dd18c878dc85

	column Autor = VAR __k = Fato_Ideias[Chave_Primaria] RETURN MAXX ( FILTER ( ALL ( Dim_Elaborador ), FORMAT ( Dim_Elaborador[Chave_Primaria], "0" ) = __k ), Dim_Elaborador[Nome_elaborador] )
		displayFolder: _Design
		lineageTag: 02eb6659-c223-d422-ada8-b36c9ec0a65a
		summarizeBy: none

	column Empresa_Sigla = RELATED ( Dim_Empresa_Campanha[Abreviação] )
		displayFolder: _Design
		lineageTag: e76a6c61-d601-e1b4-8a42-cc131ea90e11
		summarizeBy: none

	column Tema_Curto = RELATED ( Dim_Tema[Nome_tema] )
		displayFolder: _Design
		lineageTag: 5335561a-16a5-793a-423f-06aee9bbbe34
		summarizeBy: none

	column Previsto_Idea = VAR __k = Fato_Ideias[Chave_Primaria] RETURN SUMX ( FILTER ( ALL ( Dim_Valores ), Dim_Valores[Chave_Primaria] = __k ), Dim_Valores[Qual investimento previsto para implementar?] )
		dataType: double
		formatString: #,0
		displayFolder: _Design
		lineageTag: 8c858bed-5dae-8e21-e30d-50bb6e0178c4
		summarizeBy: none

	column Investido_Idea = VAR __k = Fato_Ideias[Chave_Primaria] RETURN SUMX ( FILTER ( ALL ( Dim_Valores ), Dim_Valores[Chave_Primaria] = __k ), Dim_Valores[Valor investido (R$):] ) + 0
		dataType: double
		formatString: #,0;-#,0;—
		displayFolder: _Design
		lineageTag: 554cc048-62e6-01ed-26cc-3bc38727cd02
		summarizeBy: none

	column Ganho_Idea = VAR __k = Fato_Ideias[Chave_Primaria] RETURN SUMX ( FILTER ( ALL ( Dim_Valores ), Dim_Valores[Chave_Primaria] = __k ), Dim_Valores[Qual a previsão de ganho (R$) em 12 meses?] )
		dataType: double
		formatString: #,0
		displayFolder: _Design
		lineageTag: 9fe547e9-a4f7-6b5f-81af-bbba085745ce
		summarizeBy: none

	column Busca = Fato_Ideias[Titulo] & "  ·  " & Fato_Ideias[Autor] & "  ·  " & Fato_Ideias[Empresa_Sigla] & "  ·  " & Fato_Ideias[Tema_Curto]
		displayFolder: _Design
		lineageTag: 55febbad-8278-1bce-1d61-dc2b66bfa04f
		summarizeBy: none

	column Ideia_Autor = VAR __t = Fato_Ideias[Titulo] RETURN IF ( LEN ( __t ) > 44, LEFT ( __t, 42 ) & "…", __t ) & UNICHAR ( 10 ) & Fato_Ideias[Autor]
		dataType: string
		displayFolder: _Design\Nativo
		lineageTag: 51438a4f-788d-1be0-d5cf-cc7bac4196e4
		summarizeBy: none

	column Dias_Txt = IF ( ISBLANK ( Fato_Ideias[Dias_Etapa_Atual] ), BLANK (), FORMAT ( Fato_Ideias[Dias_Etapa_Atual], "0" ) & " d" )
		dataType: string
		displayFolder: _Design\Nativo
		lineageTag: 25c2af70-d277-bd41-84e6-49873e7a5736
		summarizeBy: none
		sortByColumn: Dias_Etapa_Atual

	column Data_Etapa_Dia = IF ( ISBLANK ( Fato_Ideias[Data_Etapa_Atual] ), BLANK (), DATE ( YEAR ( Fato_Ideias[Data_Etapa_Atual] ), MONTH ( Fato_Ideias[Data_Etapa_Atual] ), DAY ( Fato_Ideias[Data_Etapa_Atual] ) ) )
		dataType: dateTime
		formatString: dd/MM/yy
		displayFolder: _Design\Nativo
		lineageTag: 465b4da0-40db-60a8-9f4b-8805bfd28a20
		summarizeBy: none

	column Data_Impl_Dia = IF ( ISBLANK ( Fato_Ideias[Data_Implantadas] ), BLANK (), DATE ( YEAR ( Fato_Ideias[Data_Implantadas] ), MONTH ( Fato_Ideias[Data_Implantadas] ), DAY ( Fato_Ideias[Data_Implantadas] ) ) )
		dataType: dateTime
		formatString: dd/MM/yy
		displayFolder: _Design\Nativo
		lineageTag: 055efe25-0447-815b-9072-6a8befc98fdd
		summarizeBy: none

	partition Fato_Ideias = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("localhost", "IdeiasDemo"),
				    Dados = Fonte{[Schema="bi", Item="vw_Fato_Ideias"]}[Data]
				in
				    Dados

	annotation PBI_NavigationStepName = Navegação

