	column Mes_Label = UPPER ( LEFT ( FORMAT ( dCalendario[Date], "mmm", "pt-BR" ), 1 ) ) & MID ( FORMAT ( dCalendario[Date], "mmm", "pt-BR" ), 2, 3 ) & REPT ( UNICHAR ( 8203 ), dCalendario[Ano] - 2000 )
		dataType: string
		displayFolder: _Design\Nativo
		lineageTag: 144d2f93-93e1-0868-d294-1b188488de80
		summarizeBy: none
		sortByColumn: AnoMesNum

	column Ult12 = VAR __d = DATEDIFF ( EOMONTH ( dCalendario[Date], 0 ), EOMONTH ( MAX ( Referencia[Hoje] ), 0 ), MONTH ) RETURN IF ( __d >= 0 && __d < 12, 1, 0 )
		dataType: int64
		formatString: 0
		displayFolder: _Design\Nativo
		lineageTag: ad1d1d4e-cfd9-dc39-6291-3995087d04b6
		summarizeBy: none

	partition dCalendario = calculated
		mode: import
		source = ```
				
				VAR DataMin = 
				    DATE ( YEAR ( MIN ( Dim_Data[Data_de_Criacao] ) ), 1, 1 )
				VAR DataMax = 
				    DATE ( 
				        MAX ( YEAR ( MAX ( Dim_Data[Data_de_Criacao] ) ), YEAR ( MAX ( Referencia[Hoje] ) ) ), 
				        12, 
				        31 
				    )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( DataMin, DataMax ),
				    "Ano",       YEAR ( [Date] ),
				    "Mes",       MONTH ( [Date] ),
				    "NomeMes",   FORMAT ( [Date], "MMM", "pt-BR" ),
				    "AnoMes",    FORMAT ( [Date], "yyyy-MM" ),
				    "AnoMesNum", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				)
				```

	annotation PBI_Id = 8ff953d89aca4f87bdc7904261ace898

